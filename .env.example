# Web sayt kirish paroli / PIN (bo'sh qoldirilsa parolsiz ishlaydi)
WEB_PASSWORD=1234

# Cookie imzolash uchun maxfiy kalit (istalgan uzun tasodifiy matn)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Telegram Bot tokeni (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=

# Ruxsat etilgan Telegram User ID lar (vergul bilan, masalan: 123456789,987654321)
# Bo'sh qoldirilsa barcha foydalanuvchilar foydalana oladi
ALLOWED_TELEGRAM_IDS=

# Coolify da biriktirilgan HTTPS domen (Telegram Mini App tugmasi uchun, ixtiyoriy)
PUBLIC_URL=https://print.yourdomain.com

# Vaqtinchalik yaratilgan fayllarni saqlash muddati (soat)
JOB_TTL_HOURS=24
